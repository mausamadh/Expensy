<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ma.finwick.sms">

    <!-- Read the user's SMS history (on-demand scan). Dangerous: requested at runtime. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Receive incoming SMS in real time (live capture). Dangerous: requested at runtime. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <application>
        <receiver
            android:name="com.ma.finwick.sms.SmsBackgroundReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
